{
  "GrayLogUrl": "http://graylog:7555/",
  "MaxGrayLogConnectionAttempt": 5,
  "HostUrls": [ "http://0.0.0.0:5000/" ],
  "AllowedOrigins": [ 
    "http://*:9000/", 
    "http://ola-laptop/backend/",
    "http://localhost/backend/" ],
  "CorsOrigins": [ 
    "http://127.0.0.1:9000", 
    "http://localhost:9000", 
    "http://127.0.0.1:9080",
    "http://localhost:9080",
    "http://127.0.0.1:8088",
    "http://localhost:8088",
    "http://127.0.0.1",
    "http://localhost",
    "http://ola-laptop/frontend/",
    "http://localhost/frontend/",
    "http://127.0.0.1/frontend/" ],
  "AllowedHosts": "*",
  "ExchangeSettings": {
    "TestMode": false,
    "IndicatorDirectoryPath": "/exchange/service/indicators",
    "INIDirectoryPath": "/exchange/service/config",
    "MainCurrency": "EUR"
  },
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/exchange/service/logs/log.txt",
          "outputTemplate": "{Timestamp} {Message}{NewLine:1}{Exception:1}"
        }
      },
      {
        "Name": "Graylog",
        "Args": {
          "hostnameOrAddress": "graylog",
          "port": "12201",
          "transportType": "Udp"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "Exchange.core"
    }
  }
}
